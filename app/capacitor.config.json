{
 "appId": "bot.tab.sites.avermessage",
 "appName": "AverChat",
 "webDir": "www",
 "server": {
  "url": "https://avermessage.sites.tab.bot",
  "androidScheme": "https",
  "allowNavigation": [
   "avermessage.sites.tab.bot"
  ],
  "errorPath": "offline.html",
  "cleartext": false
 },
 "android": {
  "backgroundColor": "#0c0718",
  "allowMixedContent": false,
  "captureInput": false,
  "webContentsDebuggingEnabled": false,
  "appendUserAgent": "AverChatApp/2.0.0 AvermessageApp/2.0.0"
 },
 "plugins": {
  "SplashScreen": {
   "launchShowDuration": 600,
   "launchAutoHide": true,
   "launchFadeOutDuration": 200,
   "backgroundColor": "#0c0718",
   "showSpinner": false,
   "androidScaleType": "CENTER_INSIDE",
   "splashFullScreen": false,
   "splashImmersive": false
  },
  "StatusBar": {
   "style": "DARK",
   "backgroundColor": "#0c0718",
   "overlaysWebView": false
  },
  "LocalNotifications": {
   "smallIcon": "ic_stat_avermessage",
   "iconColor": "#7c3aed"
  },
  "App": {
   "disableBackButtonHandler": true
  }
 }
}